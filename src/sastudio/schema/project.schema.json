{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xIBBAx/clayvoyant/schema/project-1.json",
  "title": "Clayvoyant project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "organization",
    "characters",
    "scenes"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2}|-Latn)?$"
    },
    "relpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "charStyle": {
      "type": "string",
      "enum": [
        "v1",
        "v2",
        "v3",
        "v4",
        "sketch",
        "flat",
        "cutout",
        "clay"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skin": {
          "$ref": "#/$defs/color"
        },
        "eyes": {
          "$ref": "#/$defs/color"
        },
        "lip": {
          "$ref": "#/$defs/color"
        },
        "blush": {
          "$ref": "#/$defs/color"
        },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "short",
                "side_sweep",
                "swept_back",
                "curls",
                "bob",
                "bun",
                "long",
                "ponytail",
                "headscarf",
                "bald"
              ]
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "highlight": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "outfit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "blazer",
                "suit",
                "jacket",
                "shirt",
                "sweater",
                "kurta",
                "hoodie",
                "vest"
              ]
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "shirt": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "trousers": {
          "$ref": "#/$defs/color"
        },
        "shoes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": [
                "flat",
                "sneaker",
                "brogue",
                "heel",
                "boot"
              ]
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "extras": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": [
              "glasses",
              "necklace",
              "lapel_pin",
              "freckles",
              "earrings",
              "beard",
              "moustache",
              "bindi",
              "lanyard"
            ]
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "description": "Body type for the clay figure.",
          "properties": {
            "build": {
              "enum": [
                "slim",
                "average",
                "broad"
              ]
            },
            "height": {
              "enum": [
                "short",
                "average",
                "tall"
              ]
            },
            "frame": {
              "enum": [
                "feminine",
                "masculine",
                "neutral"
              ]
            }
          }
        },
        "face": {
          "type": "object",
          "additionalProperties": false,
          "description": "Nudges to the clay face, each from -1 to 1.",
          "properties": {
            "width": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "jaw": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "chin": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "nose": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "nose_width": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "cheeks": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "brows": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "eyes": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "length": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "mouth": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "lips": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      }
    },
    "byLang": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "const": "default"
          },
          {
            "$ref": "#/$defs/lang"
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "providerName": {
      "type": "string",
      "enum": [
        "sarvam",
        "elevenlabs",
        "offline",
        "kokoro",
        "recorded"
      ]
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerName"
        },
        "model": {
          "type": "string",
          "maxLength": 60
        },
        "speaker": {
          "type": "string",
          "maxLength": 80
        },
        "voice_id": {
          "type": "string",
          "maxLength": 80
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        },
        "languages": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "$ref": "#/$defs/voice"
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "who": {
          "$ref": "#/$defs/id"
        },
        "say": {
          "$ref": "#/$defs/text"
        },
        "translations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "spoken": {
          "description": "Optional exact text for the speech engine, per language, when the template cannot express it.",
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "const": "default"
              },
              {
                "$ref": "#/$defs/lang"
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "emotion": {
          "type": "string",
          "maxLength": 30
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "pause_after": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "translations": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/lang"
              },
              "additionalProperties": {
                "$ref": "#/$defs/text"
              }
            },
            "seconds": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 30
            }
          }
        },
        "act": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 30
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "camera": {
          "type": "string",
          "maxLength": 40
        },
        "beats": {
          "type": "array",
          "maxItems": 8,
          "description": "Business at a point inside the line: someone nods, looks worried, picks up a mug (docs/DIRECTION.md#beats).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at"],
            "properties": {
              "at": {"type": "number", "minimum": 0, "maximum": 1, "description": "how far into the line, 0 to 1"},
              "who": {"$ref": "#/$defs/id"},
              "act": {"type": "string", "maxLength": 40},
              "feeling": {"type": "string", "maxLength": 40}
            },
            "anyOf": [{"required": ["act"]}, {"required": ["feeling"]}]
          }
        },
        "reactions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 40
          },
          "maxProperties": 8,
          "description": "How listeners take the line: character id -> emotion (docs/DIRECTION.md)."
        },
        "go": {
          "type": "string",
          "maxLength": 40,
          "description": "A mark of the set the speaker walks to as the line begins (docs/DIRECTION.md)."
        }
      },
      "oneOf": [
        {
          "required": [
            "id",
            "who",
            "say"
          ],
          "not": {
            "required": [
              "card"
            ]
          }
        },
        {
          "required": [
            "id",
            "card"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "who"
                ]
              },
              {
                "required": [
                  "say"
                ]
              }
            ]
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "title_translations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "$ref": "#/$defs/shortText"
          }
        },
        "topic": {
          "type": "string",
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        },
        "enabled": {
          "type": "boolean"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "setting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backdrop": {
              "type": "string",
              "maxLength": 40
            },
            "image": {
              "$ref": "#/$defs/relpath"
            },
            "time_of_day": {
              "type": "string",
              "enum": [
                "morning",
                "day",
                "evening",
                "night"
              ]
            }
          }
        },
        "headline": {
          "type": "string",
          "maxLength": 120
        },
        "headline_translations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 120
          }
        },
        "takeaway": {
          "type": "string",
          "maxLength": 300
        },
        "takeaway_translations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 300
          }
        },
        "policy_note": {
          "type": "string",
          "maxLength": 500
        },
        "max_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 1800
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "string",
              "maxLength": 40
            },
            "lighting": {
              "type": "string",
              "maxLength": 40
            },
            "transition_in": {
              "type": "string",
              "maxLength": 40
            },
            "object": {
              "type": "string",
              "maxLength": 40
            },
            "time_jump": {
              "type": "boolean"
            },
            "open_with": {
              "type": "string",
              "maxLength": 40
            },
            "props": {
              "type": "array",
              "maxItems": 16,
              "description": "Things that move on a track, at a moment of a line (docs/DIRECTION.md#props-that-move).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["thing", "line", "do"],
                "properties": {
                  "thing": {"type": "string", "maxLength": 40},
                  "line": {"$ref": "#/$defs/id"},
                  "at": {"type": "number", "minimum": 0, "maximum": 1},
                  "do": {"type": "string", "maxLength": 20},
                  "by": {"type": "array", "items": {"type": "number", "minimum": -10, "maximum": 10}, "minItems": 3, "maxItems": 3},
                  "deg": {"type": "number", "minimum": -360, "maximum": 360},
                  "frames": {"type": "integer", "minimum": 2, "maximum": 240}
                }
              }
            },
            "dressing": {
              "type": "array",
              "items": {"type": "string", "maxLength": 40},
              "uniqueItems": true,
              "maxItems": 8,
              "description": "Dressing that moves: steam, birds (docs/DIRECTION.md#dressing)."
            },
            "clock": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "description": "What the set's wall clock reads, HH:MM (default: the scene's time of day)."
            },
            "end_with": {
              "type": "object",
              "additionalProperties": false,
              "description": "How the scene ends: the last line's camera, move and the reason for it (docs/DIRECTION.md).",
              "properties": {
                "camera": {"type": "string", "maxLength": 40},
                "move": {"type": "string", "maxLength": 40},
                "why": {"type": "string", "maxLength": 160}
              }
            },
            "reactions": {
              "type": "boolean",
              "description": "Cut to the listener part way through long lines (default true)."
            },
            "light": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "temperature": {
                  "type": "number",
                  "minimum": 1800,
                  "maximum": 9000
                },
                "key_direction": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "key_height": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 85
                },
                "key_strength": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 4
                },
                "fill": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.5
                },
                "rim": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "softness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "exposure": {
                  "type": "number",
                  "minimum": -3,
                  "maximum": 3
                },
                "sun_direction": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "sun_height": {
                  "type": "number",
                  "minimum": 3,
                  "maximum": 85
                },
                "sun_strength": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "sky": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "bounce": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "practicals": {
                  "type": "boolean"
                },
                "tint": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              },
              "description": "Tune the scene's light on top of its lighting preset (docs/DIRECTION.md#light)."
            },
            "extras": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true,
              "maxItems": 8
            },
            "blocking": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 40
              }
            },
            "shots": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lines"
                ],
                "properties": {
                  "lines": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "minItems": 1,
                    "maxItems": 40
                  },
                  "camera": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "move": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "focus": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "height": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "seconds": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 120
                  },
                  "lens_mm": {
                    "type": "number",
                    "minimum": 12,
                    "maximum": 200
                  },
                  "fstop": {
                    "type": "number",
                    "minimum": 1.2,
                    "maximum": 22
                  },
                  "who": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/id"
                      },
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "maxItems": 6
                      }
                    ]
                  },
                  "part": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "A piece of one line, [from, to] as fractions of it: cut inside the line (docs/DIRECTION.md)."
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -60,
                      "maximum": 60
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "Where the camera stands, in set units [x, y, z] (docs/DIRECTION.md)."
                  },
                  "aim": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -60,
                      "maximum": 60
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "The point the camera looks at."
                  }
                }
              }
            },
            "business": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 40
              },
              "maxProperties": 8,
              "description": "What people are doing when the scene opens: character id -> a gesture that holds (typing, hold_mug, check_phone, arms_folded ...)."
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "title_translations": {
          "$ref": "#/$defs/byLang",
          "description": "The title in other languages, as {lang: text}; file names keep `title`."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "subtitle_translations": {
          "$ref": "#/$defs/byLang"
        },
        "language": {
          "$ref": "#/$defs/lang"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lang"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 12
        },
        "missing_translation": {
          "type": "string",
          "enum": [
            "error",
            "fallback"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "On-screen words the renderer adds itself, per language. English and Hindi defaults are built in.",
          "properties": {
            "key_point": {
              "$ref": "#/$defs/byLang"
            },
            "report_prompt": {
              "$ref": "#/$defs/byLang"
            },
            "topics": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 40
              },
              "additionalProperties": {
                "$ref": "#/$defs/byLang"
              }
            }
          }
        },
        "credits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "type": "boolean"
            },
            "creator": {
              "type": "string",
              "maxLength": 80
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 160
              },
              "maxItems": 40
            }
          }
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "security_email"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "short_name": {
          "$ref": "#/$defs/shortText"
        },
        "spoken_name": {
          "$ref": "#/$defs/byLang"
        },
        "security_email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "reporting_url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[^\\s]+$"
        },
        "security_team": {
          "$ref": "#/$defs/shortText"
        },
        "it_team": {
          "$ref": "#/$defs/shortText"
        },
        "training_title": {
          "$ref": "#/$defs/shortText"
        },
        "logo": {
          "$ref": "#/$defs/relpath"
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "background": {
              "$ref": "#/$defs/color"
            },
            "text": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "terms": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/shortText"
          },
          "maxProperties": 60
        },
        "announcement": {
          "type": "string",
          "maxLength": 300
        },
        "translations": {
          "description": "Organisation fields and terms in other languages, e.g. hi-IN: {security_team: ...}.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/lang"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "voice"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "role": {
            "type": "string",
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "pronouns": {
            "type": "string",
            "enum": [
              "he",
              "she",
              "they"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "masculine",
              "feminine",
              "other"
            ]
          },
          "forms": {
            "type": "object",
            "propertyNames": {
              "pattern": "^([a-z]{2,3}(-[A-Z]{2}|-Latn)?\\.|spoken\\.([a-z]{2,3}(-[A-Z]{2})?\\.)?)?[a-z][a-z0-9_]{0,29}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "spoken": {
            "$ref": "#/$defs/byLang"
          },
          "pronunciation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "elevenlabs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "alias": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "ipa": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "cmu": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              },
              "sarvam": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              },
              "offline": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          },
          "attrs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,29}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 40
            }
          },
          "voice": {
            "$ref": "#/$defs/voice"
          },
          "look": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "preset": {
                "$ref": "#/$defs/id"
              },
              "portrait": {
                "$ref": "#/$defs/relpath"
              },
              "colors": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "skin",
                    "hair",
                    "top",
                    "accent",
                    "bottom",
                    "eyes"
                  ]
                },
                "additionalProperties": {
                  "$ref": "#/$defs/color"
                }
              },
              "style": {
                "$ref": "#/$defs/charStyle"
              },
              "design": {
                "$ref": "#/$defs/design"
              },
              "model": {
                "$ref": "#/$defs/relpath"
              },
              "model_license": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "model_yaw": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "seed": {
                "type": [
                  "string",
                  "integer"
                ],
                "maxLength": 40,
                "description": "Changes the small differences that make this face its own."
              },
              "acting": {
                "type": "object",
                "additionalProperties": false,
                "description": "How the character carries themselves in clay films.",
                "properties": {
                  "energy": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 1.6
                  },
                  "looseness": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 1.6
                  },
                  "posture": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "pace": {
                    "type": "number",
                    "minimum": 0.6,
                    "maximum": 1.6
                  }
                }
              },
              "clay": {
                "type": "object",
                "additionalProperties": false,
                "description": "Sculpt parameters set outright (advanced; docs/CHARACTERS.md).",
                "properties": {
                  "head": {
                    "type": "object",
                    "maxProperties": 60,
                    "additionalProperties": {
                      "type": [
                        "number",
                        "string",
                        "array"
                      ],
                      "maxLength": 40,
                      "maxItems": 12
                    }
                  },
                  "body": {
                    "type": "object",
                    "maxProperties": 60,
                    "additionalProperties": {
                      "type": [
                        "number",
                        "string",
                        "array"
                      ],
                      "maxLength": 40,
                      "maxItems": 12
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "$ref": "#/$defs/relpath"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          {
            "$ref": "#/$defs/scene"
          }
        ]
      }
    },
    "voices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sarvam": {
              "type": "object"
            },
            "elevenlabs": {
              "type": "object"
            },
            "offline": {
              "type": "object"
            },
            "kokoro": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model_dir": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "recorded": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "folder": {
                  "$ref": "#/$defs/relpath"
                }
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_characters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "max_requests": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "timeout_seconds": {
              "type": "number",
              "minimum": 5,
              "maximum": 600
            },
            "requests_per_minute": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "prices": {
          "description": "Your own price table. The tool never ships prices; copy them from your provider's pricing page.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "per_1000_characters",
                "currency"
              ],
              "properties": {
                "per_1000_characters": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "checked": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            }
          }
        }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lexicon": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/byLang"
              }
            ]
          },
          "maxProperties": 500
        },
        "email_words": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string"
              },
              "dot": {
                "type": "string"
              },
              "dash": {
                "type": "string"
              },
              "underscore": {
                "type": "string"
              }
            }
          }
        },
        "gap_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "draft",
            "preview",
            "final"
          ]
        },
        "renderer": {
          "type": "string",
          "enum": [
            "cards",
            "clay"
          ]
        },
        "character_style": {
          "$ref": "#/$defs/charStyle"
        },
        "output": {
          "$ref": "#/$defs/relpath"
        },
        "burn_subtitles": {
          "type": "boolean"
        },
        "subtitle_speaker_labels": {
          "type": "boolean"
        },
        "intro": {
          "type": "boolean"
        },
        "outro": {
          "type": "boolean"
        },
        "music": {
          "$ref": "#/$defs/relpath"
        },
        "music_volume_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 0
        }
      }
    }
  }
}
